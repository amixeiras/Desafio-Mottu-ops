@model DesafioBackend.Web.Models.Locacoes.NovaLocacaoViewModel
@{
    ViewData["Title"] = "Nova Locação";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Criar Nova Locação</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Nova" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="EntregadorId" class="form-label fw-bold"></label>
                        <select asp-for="EntregadorId" asp-items="Model.EntregadoresDisponiveis" class="form-select">
                            <option value="">-- Selecione o Entregador --</option>
                        </select>
                        <span asp-validation-for="EntregadorId" class="text-danger small"></span>
                        <div class="form-text">Apenas entregadores com CNH categoria <strong>A</strong> ou <strong>A+B</strong> e sem locação ativa podem alugar motos.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MotoId" class="form-label fw-bold"></label>
                        <select asp-for="MotoId" asp-items="Model.MotosDisponiveis" class="form-select">
                            <option value="">-- Selecione a Moto --</option>
                        </select>
                        <span asp-validation-for="MotoId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Plano" class="form-label fw-bold"></label>
                        <select asp-for="Plano" class="form-select">
                            <option value="7">Plano 7 Dias — R$ 30,00/dia (Multa 20% p/ devolução antecipada)</option>
                            <option value="15">Plano 15 Dias — R$ 28,00/dia (Multa 40% p/ devolução antecipada)</option>
                            <option value="30">Plano 30 Dias — R$ 22,00/dia</option>
                            <option value="45">Plano 45 Dias — R$ 20,00/dia</option>
                            <option value="50">Plano 50 Dias — R$ 18,00/dia</option>
                        </select>
                        <span asp-validation-for="Plano" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border small mb-4">
                        📅 <strong>Regra de Negócio:</strong> A data de início da locação será definida automaticamente para o primeiro dia após a criação (<strong>@DateTime.UtcNow.AddDays(1).ToString("dd/MM/yyyy")</strong>).
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Confirmar Locação</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

