@model DesafioBackend.Web.Models.Motos.CadastrarMotoViewModel
@{
    ViewData["Title"] = "Cadastrar Moto";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Cadastrar Nova Moto</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Cadastrar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Identificador" class="form-label fw-bold"></label>
                        <input asp-for="Identificador" class="form-control" placeholder="Ex: moto123" />
                        <span asp-validation-for="Identificador" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Modelo" class="form-label fw-bold"></label>
                        <input asp-for="Modelo" class="form-control" placeholder="Ex: Motor Rent Sport" />
                        <span asp-validation-for="Modelo" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Ano" class="form-label fw-bold"></label>
                            <input asp-for="Ano" class="form-control" type="number" />
                            <span asp-validation-for="Ano" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Placa" class="form-label fw-bold"></label>
                            <input asp-for="Placa" class="form-control text-uppercase" placeholder="Ex: MOT-2024" />
                            <span asp-validation-for="Placa" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info small mb-4">
                        💡 <strong>Observação:</strong> O cadastro de motos do ano <strong>2024</strong> dispara automaticamente uma notificação gravada via mensageria (RabbitMQ).
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Salvar Moto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

