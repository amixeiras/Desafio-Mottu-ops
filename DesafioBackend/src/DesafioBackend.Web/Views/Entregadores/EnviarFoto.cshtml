@model DesafioBackend.Web.Models.Entregadores.EnviarFotoCnhViewModel
@{
    ViewData["Title"] = "Enviar Foto da CNH";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Atualizar Foto da CNH</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="EnviarFoto" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Identificador do Entregador</label>
                        <input value="@Model.Id" class="form-control" disabled />
                    </div>

                    <div class="mb-4">
                        <label asp-for="FotoCnh" class="form-label fw-bold"></label>
                        <input asp-for="FotoCnh" class="form-control" type="file" accept=".png,.bmp" />
                        <span asp-validation-for="FotoCnh" class="text-danger small"></span>
                        <div class="form-text">Aceita apenas arquivos nos formatos <strong>.PNG</strong> ou <strong>.BMP</strong>.</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary px-4">Enviar Foto</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

