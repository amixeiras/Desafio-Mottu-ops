@model DesafioBackend.Web.Models.Motos.EditarPlacaViewModel
@{
    ViewData["Title"] = "Editar Placa";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h1 class="h4 mb-0">Modificar Placa da Moto</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditarPlaca" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Identificador da Moto</label>
                        <input value="@Model.Id" class="form-control" disabled />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Placa" class="form-label fw-bold"></label>
                        <input asp-for="Placa" class="form-control text-uppercase" />
                        <span asp-validation-for="Placa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary px-4">Salvar Nova Placa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

